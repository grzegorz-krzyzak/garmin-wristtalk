<properties>
    <!-- The house address (HTTPS) - pasted from the WristTalk integration in Home Assistant -->
    <property id="houseUrl" type="string">https://</property>
    <!-- Start listening as soon as the app opens -->
    <property id="listenOnOpen" type="boolean">true</property>
    <!-- After a reply: 0 = wait for START, 1 = listen again (conversation mode) -->
    <property id="afterReply" type="number">0</property>
    <!-- Reply: 0 = voice and text, 1 = text only (also the quick switch in the watch menu) -->
    <property id="replyMode" type="number">0</property>
    <!-- Reply volume: 0 = quiet, 1 = medium, 2 = loud -->
    <property id="volume" type="number">1</property>
    <!-- 0 = full (start, sent, reply, error), 1 = minimal (reply, error), 2 = off -->
    <property id="vibration" type="number">1</property>
    <!-- Close after this many seconds without input -->
    <property id="idleExitS" type="number">30</property>
    <!-- The text of the watch face complication (Face It, some Connect IQ faces): up to 12 characters, empty = the icon alone -->
    <property id="complicationText" type="string">WristTalk</property>
    <!-- Read only: the help page, visible in the Connect IQ app (it does not show the settings' help links) -->
    <property id="help" type="string">https://grzegorz-krzyzak.github.io/wristtalk/help/</property>
</properties>
